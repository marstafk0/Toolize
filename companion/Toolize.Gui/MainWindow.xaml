<Window x:Class="Toolize.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Toolize" Height="720" Width="520"
        Background="#FBFAF8" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#1D1C1A" />
        <SolidColorBrush x:Key="Muted" Color="#6B6862" />
        <SolidColorBrush x:Key="Line" Color="#E4E1DB" />
        <SolidColorBrush x:Key="Accent" Color="#2F5D50" />
        <SolidColorBrush x:Key="Bad" Color="#B03A2E" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#C9C6C0" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Toolize" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Text="" Margin="10,6,0,0" Foreground="{StaticResource Muted}" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Margin="0,6,0,0" Text="Connecting to the Toolize service…" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="PROTECTION" />
                        <CheckBox x:Name="EnabledBox" Content="Blur explicit images and video" Click="OnSettingChanged" />

                        <TextBlock Margin="0,14,0,6" FontWeight="SemiBold" Text="Sensitivity" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="PresetStrict" GroupName="preset" Content="Strict" Click="OnSettingChanged" />
                            <RadioButton x:Name="PresetBalanced" GroupName="preset" Content="Balanced" Click="OnSettingChanged" />
                            <RadioButton x:Name="PresetRelaxed" GroupName="preset" Content="Relaxed" Click="OnSettingChanged" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" x:Name="PresetHint" />

                        <TextBlock Margin="0,14,0,6" FontWeight="SemiBold" Text="Reveal mode" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ModeSafe" GroupName="mode" Content="Safe reveal" Click="OnSettingChanged" />
                            <RadioButton x:Name="ModeFast" GroupName="mode" Content="Detect, then blur" Click="OnSettingChanged" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" x:Name="ModeHint" />

                        <CheckBox x:Name="BlockSitesBox" Margin="0,14,0,0" Content="Block known adult sites before they load" Click="OnSettingChanged" />
                        <CheckBox x:Name="AllowLiveBox" Margin="0,8,0,0" Content="Don't filter live streams on YouTube, Twitch, Kick and Rumble" Click="OnSettingChanged" />
                        <TextBlock Style="{StaticResource Hint}" Text="Live video plays untouched on those four sites. Turning this on needs your key." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="WORD FILTER" />
                        <CheckBox x:Name="WordFilterBox" Content="Block pages and searches with blocked words, and hide matching YouTube videos" Click="OnSettingChanged" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="A built-in list covers explicit and revealing terms (porn, nude, bikini, try-on haul…). Add your own below, one per line; /pattern/ for a regular expression. Removing a word needs your key." />
                        <TextBox x:Name="WordsBox" Margin="0,8,0,0" Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                        <Button x:Name="SaveWordsButton" Margin="0,8,0,0" HorizontalAlignment="Left" Content="Save words" Click="OnSettingChanged" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="TRUSTED YOUTUBE CHANNELS" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,0"
                                   Text="Videos, Shorts and thumbnails from these channels skip the image check. For channels the checker gets wrong, like butchery and cooking channels (raw meat looks like skin to it). One name or @handle per line. Adding a channel needs your key; the word filter still applies." />
                        <TextBox x:Name="ChannelsBox" Margin="0,8,0,0" Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                        <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="Save channels" Click="OnSettingChanged" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="FEEDS" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                                   Text="Hide the endless parts of these sites. Turning one back on needs your key." />
                        <StackPanel x:Name="FeedsPanel" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="YouTube commenter avatars and profile links are always off, and porn-spam bot comments are hidden. Feeds and these protections turn off with protection." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="BROWSER EXTENSION" />
                        <TextBlock x:Name="ExtensionText" Text="Checking…" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="UNLOCK KEY" />
                        <TextBlock x:Name="LockText" Text="No key enrolled." />
                        <TextBlock Style="{StaticResource Hint}" x:Name="LockHint"
                                   Text="A dedicated USB key gates every change that weakens protection. Removing it re-locks immediately." />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="EnrollButton" Content="Set up a USB key" Click="OnEnrollClicked" />
                            <Button x:Name="RevokeButton" Margin="8,0,0,0" Background="#8A8A8A" Content="Remove key"
                                    Visibility="Collapsed" Click="OnRevokeClicked" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="ENFORCEMENT" />
                        <CheckBox x:Name="EnforceBox" Content="Stop the extension being removed from the browser" Click="OnSettingChanged" />
                        <TextBlock Style="{StaticResource Hint}" x:Name="EnforceHint" />
                        <StackPanel x:Name="EnforceOptions" Margin="18,10,0,0">
                            <CheckBox x:Name="BlockIncognitoBox" Content="Block private windows and new profiles" Click="OnSettingChanged" />
                            <CheckBox x:Name="BlockOtherExtBox" Margin="0,6,0,0" Content="Block all other extensions" Click="OnSettingChanged" />
                            <CheckBox x:Name="BlockDevToolsBox" Margin="0,6,0,0" Content="Turn off developer tools (also blocks loading unpacked extensions)" Click="OnSettingChanged" />
                            <TextBlock Margin="0,10,0,4" FontWeight="SemiBold" Text="If a browser runs unprotected" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="WatchdogOff" GroupName="watchdog" Content="Ignore" Click="OnSettingChanged" />
                                <RadioButton x:Name="WatchdogWarn" GroupName="watchdog" Content="Warn me" Click="OnSettingChanged" />
                                <RadioButton x:Name="WatchdogClose" GroupName="watchdog" Content="Close it" Click="OnSettingChanged" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" x:Name="WatchdogHint" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="UPDATES" />
                        <TextBlock x:Name="UpdateText" Text="Checking for updates…" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="UpdateButton" Content="Check for updates" Click="OnUpdateClicked" />
                            <TextBlock x:Name="ChannelText" Margin="12,8,0,0" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="RECENT ACTIVITY" />
                        <TextBlock x:Name="NotesText" Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="11"
                                   Text="Nothing yet." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
