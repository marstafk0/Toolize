{
  "name": "toolize-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:dev": "node build.mjs --dev",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "serve-test": "node scripts/serve-test.mjs",
    "test:e2e": "node build.mjs --dev && node test/e2e.mjs",
    "corpus": "node build.mjs --dev && node test/corpus-run.mjs"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "nsfwjs": "^4.4.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3"
  }
}
