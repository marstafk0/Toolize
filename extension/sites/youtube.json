{
  "id": "youtube",
  "name": "YouTube",
  "hosts": ["youtube.com"],
  "toggles": [
    {
      "id": "home",
      "label": "Home feed",
      "hint": "The recommended grid on the home page. Search and subscriptions still work.",
      "hide": [
        "ytd-browse[page-subtype=\"home\"] ytd-rich-grid-renderer",
        "ytd-browse[page-subtype=\"home\"] #chips-wrapper"
      ],
      "notice": {
        "at": "ytd-browse[page-subtype=\"home\"] #primary",
        "text": "Home feed hidden by Toolize. Search for what you came for."
      }
    },
    {
      "id": "shorts",
      "label": "Shorts",
      "hint": "Shorts shelves, the Shorts tab and sidebar entry. Shorts links open as normal videos.",
      "hide": [
        "ytd-guide-entry-renderer:has(a[title=\"Shorts\"])",
        "ytd-mini-guide-entry-renderer[aria-label=\"Shorts\"]",
        "ytd-reel-shelf-renderer",
        "ytd-rich-shelf-renderer[is-shorts]",
        "ytd-rich-section-renderer:has(ytd-rich-shelf-renderer[is-shorts])",
        "ytd-rich-section-renderer:has(ytm-shorts-lockup-view-model)",
        "grid-shelf-view-model:has(a[href^=\"/shorts/\"])",
        "ytd-rich-item-renderer:has(a[href^=\"/shorts/\"])",
        "ytd-video-renderer:has(a[href^=\"/shorts/\"])",
        "ytd-grid-video-renderer:has(a[href^=\"/shorts/\"])",
        "yt-tab-shape[tab-title=\"Shorts\"]"
      ],
      "redirect": { "from": "^/shorts/([\\w-]+).*", "to": "/watch?v=$1" }
    },
    {
      "id": "related",
      "label": "Recommended videos",
      "hint": "The sidebar next to the video you're watching. Playlists stay.",
      "hide": [
        "ytd-watch-flexy #related",
        "ytd-watch-next-secondary-results-renderer"
      ]
    },
    {
      "id": "comments",
      "label": "Comments",
      "hint": "Comments under videos and on Shorts. Commenter avatars and profile links are off either way.",
      "hide": [
        "ytd-comments > *",
        "ytd-engagement-panel-section-list-renderer[target-id=\"engagement-panel-comments-section\"]",
        "ytd-shorts #comments-button"
      ],
      "notice": { "at": "ytd-comments", "text": "Comments hidden by Toolize." }
    },
    {
      "id": "endScreen",
      "label": "End screens",
      "hint": "Video cards over the last seconds of a video, and the wall of suggestions after it.",
      "hide": [
        ".ytp-ce-element",
        ".ytp-endscreen-content",
        ".ytp-endscreen-previous",
        ".ytp-endscreen-next",
        ".ytp-autonav-endscreen-countdown-overlay",
        ".ytp-autonav-endscreen-upnext-container",
        ".ytp-fullscreen-grid",
        ".ytp-fullscreen-grid-stills-container"
      ]
    }
  ]
}
